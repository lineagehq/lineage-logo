{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineage-logo.localhost/schemas/public-beta/distinct-user-attestation-v1.json",
  "title": "Lineage Logo distinct-user aggregate attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_version", "kind", "attestation_date", "collection_window_start", "collection_window_end", "collection_window_days", "channel_class", "accepted_count", "accepted_receipts", "rejection_counts", "fixed_statements", "statement", "limitation"],
  "properties": {
    "attestation_version": { "const": 1 },
    "kind": { "const": "lineage-logo.public-beta.distinct-user-attestation" },
    "attestation_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "collection_window_start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "collection_window_end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "collection_window_days": { "type": "integer", "minimum": 1, "maximum": 14 },
    "channel_class": { "const": "owner_approved_private_authenticated_deletable" },
    "accepted_count": { "const": 3 },
    "accepted_receipts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_id", "walkthrough_id", "receipt_sha256"],
        "properties": {
          "participant_id": { "type": "string", "pattern": "^P-[A-F0-9]{32}$" },
          "walkthrough_id": { "type": "string", "pattern": "^W-[A-F0-9]{32}$" },
          "receipt_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
        }
      }
    },
    "rejection_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_invalid", "duplicate_identifier", "duplicate_sender", "prohibited_data", "unsupported_attempt", "non_passing"],
      "properties": {
        "schema_invalid": { "type": "integer", "minimum": 0 },
        "duplicate_identifier": { "type": "integer", "minimum": 0 },
        "duplicate_sender": { "type": "integer", "minimum": 0 },
        "prohibited_data": { "type": "integer", "minimum": 0 },
        "unsupported_attempt": { "type": "integer", "minimum": 0 },
        "non_passing": { "type": "integer", "minimum": 0 }
      }
    },
    "fixed_statements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distinct_authenticated_senders_verified", "one_counting_receipt_per_sender", "no_identity_mapping_retained", "source_payloads_removed_from_project_control", "no_maintainer_coaching", "provider_metadata_deletion_not_claimed"],
      "properties": {
        "distinct_authenticated_senders_verified": { "const": true },
        "one_counting_receipt_per_sender": { "const": true },
        "no_identity_mapping_retained": { "const": true },
        "source_payloads_removed_from_project_control": { "const": true },
        "no_maintainer_coaching": { "const": true },
        "provider_metadata_deletion_not_claimed": { "const": true }
      }
    },
    "statement": { "const": "During the stated collection window, a maintainer transiently verified that the three digest-bound accepted receipts came from three distinct owner-approved authenticated human senders, with at most one counting receipt per sender. The project retained only the controlled receipt JSON, its SHA-256 digest, aggregate counts, and this dated attestation; it retained no sender, contact, account, recipient, message, thread, or sender-to-receipt mapping. Receipt-bearing source messages and attachments were removed from project-controlled channel storage. No maintainer coached, observed, controlled, or repaired a counting attempt. This attestation makes no claim about provider-controlled metadata retention and is not independently re-auditable identity proof." },
    "limitation": { "const": "This attestation is privacy-minimal aggregate evidence, not cryptographic or independently re-auditable identity proof." }
  }
}
