{
  "name": "lineage-logo",
  "version": "0.1.0-beta.1",
  "description": "A local, human-in-the-loop SVG logo correction canvas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lineagehq/lineage-logo.git"
  },
  "homepage": "https://github.com/lineagehq/lineage-logo#readme",
  "bugs": {
    "url": "https://github.com/lineagehq/lineage-logo/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "type": "module",
  "bin": {
    "lineage-logo": "dist/cli/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**",
    "README.md",
    "examples/seatify-constellation.svg",
    "docs/public-beta/**"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.cli.json",
    "agent:submit": "tsx scripts/logo-designer-adapter.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "tsx scripts/dev.ts",
    "prepack": "npm run build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@svgdotjs/svg.draggable.js": "^3.0.6",
    "@svgdotjs/svg.js": "^3.2.8",
    "@svgdotjs/svg.resize.js": "^2.0.5",
    "@svgdotjs/svg.select.js": "^4.0.3",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "happy-dom": "^20.11.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
