{
  "name": "lineage-logo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "agent:submit": "tsx scripts/logo-designer-adapter.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx src/server/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "node-editor-plugin:build": "node scripts/build-lineage-node-editor-plugin.mjs",
    "node-editor-plugin:test": "node --test test/node-editor-plugin.test.mjs && node scripts/test-lineage-node-editor-artifact.mjs",
    "node-editor-plugin:conformance": "node scripts/check-lineage-node-editor-contract.mjs",
    "node-editor-plugin:artifact:repro": "node scripts/test-lineage-node-editor-artifact.mjs --repro",
    "node-editor-plugin:browser-smoke": "node scripts/node-editor-plugin-browser-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@svgdotjs/svg.draggable.js": "^3.0.6",
    "@svgdotjs/svg.js": "^3.2.8",
    "@svgdotjs/svg.resize.js": "^2.0.5",
    "@svgdotjs/svg.select.js": "^4.0.3",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "happy-dom": "^20.11.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
